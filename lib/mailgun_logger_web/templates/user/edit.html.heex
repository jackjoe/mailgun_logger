<h1>Edit user</h1>
{render("form.html",
  action: Routes.user_path(@conn, :update, @user),
  changeset: @changeset,
  new?: false,
  flash: @flash,
  all_roles: @all_roles,
  selected_role_ids: @selected_role_ids,
  show_roles?: @show_roles?
)}
<br />
<.link
  href={Routes.user_path(@conn, :delete, @user)}
  method="delete"
  data-confirm="Are you sure?"
  class="btn btn-danger btn-sm"
>
  delete
</.link>
