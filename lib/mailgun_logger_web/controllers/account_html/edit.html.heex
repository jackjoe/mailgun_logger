<Layouts.app flash={@flash} conn={@conn}>
  <h1>Edit account</h1>
  <.account_form action={~p"/accounts/#{@account}"} changeset={@changeset} />
  <br />
  <.link
    href={~p"/accounts/#{@account}"}
    method="delete"
    data-confirm="Are you sure?"
    class="btn btn-danger btn-sm"
  >
    delete
  </.link>
</Layouts.app>
