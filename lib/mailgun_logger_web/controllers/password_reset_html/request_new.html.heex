<Layouts.app flash={@flash} conn={@conn}>
  <div class="mx-auto panel">
    <.form for={%{}} action={~p"/password-reset/request"}>
      <h2 class="h2">{gettext("Forgot your password?")}</h2>
      <p class="mb-4">
        {gettext(
          "Enter the email address of your account. We will send you a link to reset your password."
        )}
      </p>

      <div class="form-group">
        <label for="password_reset_email">{gettext("Email")}</label>
        <input
          type="email"
          name="password_reset[email]"
          id="password_reset_email"
          required
          class="form-control"
        />
      </div>

      <.button type="submit" class="btn btn-primary">{gettext("Send reset link")}</.button>
    </.form>
  </div>
</Layouts.app>
