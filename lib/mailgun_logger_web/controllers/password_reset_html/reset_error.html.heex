<Layouts.app flash={@flash} conn={@conn} show_flash={false}>
  <div class="mx-auto panel">
    <h2 class="h2">{gettext("Invalid reset link")}</h2>
    <.flash_group flash={@flash} />
    <p class="mb-4">
      {raw(
        gettext(
          "This password reset link is invalid or was already used. You can %{request_open}request a new link%{link_close} or continue to the %{login_open}login page%{link_close}.",
          request_open: ~s(<a href="#{~p"/password-reset/request"}">),
          login_open: ~s(<a href="#{~p"/login"}">),
          link_close: "</a>"
        )
      )}
    </p>
  </div>
</Layouts.app>
